<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="QRCodeGeneratorNative.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <!-- Row 0: Monetization Banner (Ad / Promo slot) -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Main Application Content -->
            <RowDefinition Height="*" />
            <!-- Row 2: Status / Footer Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- AD / PROMO BANNER CONTAINER (Controlled by Store License)         -->
        <!-- ================================================================= -->
        <Border x:Name="AdBannerContainer"
                Grid.Row="0"
                Margin="16,8,16,8"
                Padding="16,12"
                CornerRadius="8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Sponsored / Featured" FontWeight="SemiBold" FontSize="14" />
                        <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                CornerRadius="4" Padding="6,1">
                            <TextBlock Text="AD" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Support development or upgrade to Pro to remove all ads and unlock vector SVG export."
                               FontSize="12"
                               Opacity="0.8"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="BtnUpgradePro"
                            Content="⭐ Remove Ads ($1.99)"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="BtnUpgradePro_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- MAIN QR CODE GENERATOR WORKSPACE                                 -->
        <!-- ================================================================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="16,8,16,16" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Inputs & Controls -->
                <StackPanel Grid.Column="0" Spacing="16">
                    <TextBlock Text="🔳 QR Code Generator" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Fast, lightweight, native offline QR generator." Opacity="0.7" Margin="0,-12,0,0" />

                    <!-- Input Text / Link -->
                    <TextBox x:Name="TxtInput"
                             Header="Link or text to encode"
                             PlaceholderText="https://yourlink.com or any text..."
                             AcceptsReturn="True"
                             MinHeight="100"
                             TextWrapping="Wrap"
                             TextChanged="TxtInput_TextChanged" />

                    <!-- Customization Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Options &amp; Customization" FontWeight="SemiBold" FontSize="15" />

                            <ComboBox x:Name="CmbErrorCorrection"
                                      Header="Error Correction Level"
                                      SelectedIndex="1"
                                      SelectionChanged="CmbErrorCorrection_SelectionChanged"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="L (Low ≈ 7%)" Tag="L" />
                                <ComboBoxItem Content="M (Medium ≈ 15%)" Tag="M" />
                                <ComboBoxItem Content="Q (Quartile ≈ 25%)" Tag="Q" />
                                <ComboBoxItem Content="H (High ≈ 30%)" Tag="H" />
                            </ComboBox>

                            <Slider x:Name="SldModuleSize"
                                    Header="Pixel Box Size"
                                    Minimum="4"
                                    Maximum="30"
                                    Value="12"
                                    ValueChanged="SldModuleSize_ValueChanged" />

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtDarkColor" Grid.Column="0" Header="Dark Color (Hex)" Text="#000000" TextChanged="Color_TextChanged" />
                                <TextBox x:Name="TxtLightColor" Grid.Column="1" Header="Light Color (Hex)" Text="#FFFFFF" TextChanged="Color_TextChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column: Live Preview & Export -->
                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            HorizontalAlignment="Stretch">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <TextBlock Text="Preview" FontWeight="SemiBold" HorizontalAlignment="Center" />

                            <Border Background="White"
                                    CornerRadius="6"
                                    Padding="10"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    Width="260"
                                    Height="260">
                                <Image x:Name="ImgPreview"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Border>

                            <Button x:Name="BtnSavePng"
                                    Content="💾 Save PNG"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Click="BtnSavePng_Click" />

                            <Button x:Name="BtnSaveSvg"
                                    Content="📐 Save SVG (Vector)"
                                    HorizontalAlignment="Stretch"
                                    Click="BtnSaveSvg_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtTierBadge" Text="Standard (Ad-supported)" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Page>
