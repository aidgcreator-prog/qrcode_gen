# ==============================================================================
.env
.env.*
*.env
secrets.toml
.streamlit/secrets.toml
.streamlit/secrets.toml.*
*.pem
*.key
*.cert
*.pfx
*.p12
*.kdbx
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# ==============================================================================
