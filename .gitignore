# ==============================================================================
# User Outputs, Generated Files & Personal Data
# ==============================================================================
# Output directory contents (keep directory structure tracked via .gitkeep)
outputs/*
!outputs/.gitkeep
output/*
!output/.gitkeep

# User data directories
user_data/
inputs/
input/
uploads/
downloads/
tutorial/

# User datasets and database files
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.feather
*.db
*.sqlite
*.sqlite3
*.json.user

# User-generated image, vector, and document exports
# (Repository branding assets in image/ are explicitly preserved below)
*.png
*.jpg
*.jpeg
*.svg
*.webp
*.gif
*.bmp
*.ico
*.pdf
*.tiff

# Preserve repository assets
!image/
!image/**

# ==============================================================================
